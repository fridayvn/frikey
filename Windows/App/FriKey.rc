#include <windows.h>
#include "resource.h"
IDI_APP ICON "FriKey.ico"
1 24 "FriKey.manifest"
IDR_SOUND_VI RCDATA "Sounds/SwitchToVietnamese.wav"
IDR_SOUND_EN RCDATA "Sounds/SwitchToEnglish.wav"
IDR_EMOJI_JSON RCDATA "../../App/Resources/Emoji.json"
IDR_FONT_REGULAR RCDATA "Fonts/PlusJakartaSans-Regular.ttf"
IDR_FONT_MEDIUM RCDATA "Fonts/PlusJakartaSans-Medium.ttf"
IDR_FONT_SEMIBOLD RCDATA "Fonts/PlusJakartaSans-SemiBold.ttf"
IDR_FONT_BOLD RCDATA "Fonts/PlusJakartaSans-Bold.ttf"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Friday"
      VALUE "FileDescription", "FriKey - Vietnamese Input by Friday"
      VALUE "FileVersion", FRIKEY_VERSION
      VALUE "InternalName", "FriKey"
      VALUE "LegalCopyright", "GPL-3.0. Based on Vikey by Tony Dinh and OpenKey by Tuyen Mai."
      VALUE "OriginalFilename", "FriKey.exe"
      VALUE "ProductName", "FriKey"
      VALUE "ProductVersion", FRIKEY_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
